# =============================================================================
# DAKSHORA 2.0 - BACKEND ENVIRONMENT TEMPLATE
# Copy to backend/.env and provide production credentials for deployment.
# =============================================================================

# Server Gateway Configuration
PORT=5000
NODE_ENV=production
FASTIFY_ADDRESS=0.0.0.0

# Supabase Production PostgreSQL & Storage
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<production-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<production-service-role-key>

# Platform Super Admin Bootstrap (Optional)
DAKSHORA_SUPER_ADMIN_EMAIL=superadmin@dakshora.com
DAKSHORA_SUPER_ADMIN_PASSWORD=<secure-superadmin-password>

# Razorpay Payment Gateway (Production / Test)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# SMS Gateway — Fast2SMS (DLT Compliant)
FAST2SMS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FAST2SMS_SENDER_ID=DKSHRA
FAST2SMS_ENTITY_ID=1201159123456789012

# SMS / WhatsApp Gateway — Twilio (Fallback & Global)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15005550006
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_STATUS_CALLBACK=https://dakshora-api.onrender.com/api/erp/communication/webhooks/twilio

# WhatsApp Gateway — Gupshup Enterprise (Optional)
GUPSHUP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GUPSHUP_APP_NAME=DakshoraERP
GUPSHUP_SOURCE_NUMBER=919876543210

# SMTP Email Relay (Transactional Email / Notifications / Receipts)
# Supported: AWS SES, SendGrid, Mailgun, Brevo, Custom SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM=Dakshora ERP <no-reply@dakshora.co.in>
SMTP_SECURE=false