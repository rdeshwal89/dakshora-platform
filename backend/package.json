{
  "name": "dakshora-backend",
  "version": "1.0.0",
  "description": "Dakshora 2.0 Backend API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test test/security-audit.test.ts test/erp-architecture-e2e.test.ts test/production-transformation.test.ts test/master-onboarding-cms-suite.test.ts test/master-erp-full-suite.test.ts test/tenant-isolation-zero-state.test.ts",
    "test:security": "tsx --test test/security-audit.test.ts",
    "test:erp": "tsx --test test/erp-architecture-e2e.test.ts",
    "test:production": "tsx --test test/production-transformation.test.ts",
    "test:onboarding": "tsx --test test/master-onboarding-cms-suite.test.ts",
    "test:erp-full": "tsx --test test/master-erp-full-suite.test.ts",
    "test:tenant-isolation": "tsx --test test/tenant-isolation-zero-state.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/express": "^4.0.7",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@types/pg": "^8.23.1",
    "cors": "^2.8.6",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "fastify": "^5.0.0",
    "pg": "^8.23.1",
    "razorpay": "^2.9.8",
    "uuid": "^14.0.3",
    "ws": "^8.21.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
