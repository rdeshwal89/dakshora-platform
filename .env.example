# =============================================================================
# DAKSHORA 2.0 - ROOT ENVIRONMENT TEMPLATE
# Do NOT place actual secret keys in this template file.
# Copy to backend/.env and frontend/.env.local for local development.
# =============================================================================

# --- Backend Configuration (Fastify Gateway) ---
PORT=5000
NODE_ENV=production

# Supabase Production Configuration
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-production-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-production-service-role-key>

# --- Frontend Configuration (Next.js) ---
NEXT_PUBLIC_API_URL=https://api.dakshora.in
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-production-anon-key>

# AI Assistant Integration (Optional)
OPENROUTER_API_KEY=<your-openrouter-api-key>
