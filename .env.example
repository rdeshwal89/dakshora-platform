# =============================================================================
# DAKSHORA 2.0 - ROOT ENVIRONMENT TEMPLATE
# Do NOT place actual secret keys in this template file.
# Copy to backend/.env and frontend/.env.local for local development.
# =============================================================================

# --- Backend Configuration (Fastify Gateway) ---
PORT=5000
NODE_ENV=production
FASTIFY_ADDRESS=0.0.0.0

# Supabase Production Configuration
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-production-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-production-service-role-key>

# Platform Super Admin Bootstrap
DAKSHORA_SUPER_ADMIN_EMAIL=superadmin@dakshora.com
DAKSHORA_SUPER_ADMIN_PASSWORD=<secure-superadmin-password>

# Razorpay Online Payment Gateway
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# SMS Gateway (Fast2SMS DLT)
FAST2SMS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FAST2SMS_SENDER_ID=DKSHRA
FAST2SMS_ENTITY_ID=1201159123456789012

# Twilio SMS / WhatsApp Gateway
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15005550006
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_STATUS_CALLBACK=https://dakshora-api.onrender.com/api/erp/communication/webhooks/twilio

# SMTP Email Relay (Transactional Email / Notifications / Receipts)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM=Dakshora ERP <no-reply@dakshora.co.in>
SMTP_SECURE=false

# --- Frontend Configuration (Next.js) ---
NEXT_PUBLIC_API_URL=https://dakshora-api.onrender.com
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-production-anon-key>

# AI Assistant Integration (Optional)
OPENROUTER_API_KEY=<your-openrouter-api-key>
